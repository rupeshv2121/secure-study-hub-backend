generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id                String     @id @default(cuid())
  supabaseId        String?    @unique
  email             String     @unique
  name              String
  phoneNumber       String?
  passwordHash      String
  role              UserRole   @default(STUDENT)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  purchases         Purchase[]
  reviewedPurchases Purchase[] @relation("PurchaseReviewedBy")
}

model Subject {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  lectures    Lecture[]
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Lecture {
  id            String         @id @default(cuid())
  subject       Subject        @relation(fields: [subjectId], references: [id])
  subjectId     String
  title         String
  description   String?
  contentUrl    String?
  price         Float          @default(0)
  published     Boolean        @default(false)
  order         Int            @default(0)
  viewCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  purchases     Purchase[]
  lectureSlides LectureSlide[]
  viewLogs      ViewLog[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LectureSlide {
  id          String   @id @default(cuid())
  lecture     Lecture  @relation(fields: [lectureId], references: [id])
  lectureId   String
  slideNumber Int
  storagePath String
  createdAt   DateTime @default(now())
}

model ViewLog {
  id        String   @id @default(cuid())
  lecture   Lecture  @relation(fields: [lectureId], references: [id])
  lectureId String
  userId    String
  createdAt DateTime @default(now())
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  REFUNDED
}

model Purchase {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  subject        Subject?       @relation(fields: [subjectId], references: [id])
  subjectId      String?
  lecture        Lecture?       @relation(fields: [lectureId], references: [id])
  lectureId      String?
  amount         Float
  currency       String         @default("INR")
  status         PurchaseStatus @default(PENDING)
  screenshotPath String?
  adminNote      String?
  reviewedBy     User?          @relation("PurchaseReviewedBy", fields: [reviewedById], references: [id])
  reviewedById   String?
  reviewedAt     DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
